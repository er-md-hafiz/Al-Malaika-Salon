      "label": "Full Name",
      "type": "text",
      "placeholder": "Enter your full name",
      "required": true,
      "order": 1
    },
    {
      "id": "phone",
      "label": "Mobile Number",
      "type": "phone",
      "placeholder": "Enter 10-digit mobile number",
      "required": true,
      "order": 2
    },
    {
      "id": "address",
      "label": "Complete Home Address & Landmark",
      "type": "address",
      "placeholder": "House/Flat no, Street, Landmark, Area in Hazaribagh",
      "required": true,
      "order": 3
    },
    {
      "id": "service",
      "label": "Select Service",
      "type": "service",
